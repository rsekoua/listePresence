# systemd — Gunicorn pour Gestion de Présence
# Installation :
#   sudo cp deploy/gunicorn.service /etc/systemd/system/presence.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now presence
# (adapter User, chemins et le nombre de workers)

[Unit]
Description=Gunicorn - Gestion de Présence
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/presence/backend
EnvironmentFile=/var/www/presence/backend/.env
ExecStart=/var/www/presence/backend/.venv/bin/gunicorn \
    config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

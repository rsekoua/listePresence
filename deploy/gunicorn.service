# systemd — Gunicorn pour Gestion de Présence
# Installation :
#   sudo cp deploy/gunicorn.service /etc/systemd/system/presence.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now presence
#
# User/chemins ci-dessous correspondent au site CloudPanel "liste.rsekoua.org"
# (utilisateur système "liste", racine /home/liste/htdocs/liste.rsekoua.org).

[Unit]
Description=Gunicorn - Gestion de Présence
After=network.target

[Service]
User=liste
Group=liste
WorkingDirectory=/home/liste/htdocs/liste.rsekoua.org/backend
EnvironmentFile=/home/liste/htdocs/liste.rsekoua.org/backend/.env
ExecStart=/home/liste/htdocs/liste.rsekoua.org/backend/.venv/bin/gunicorn \
    config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

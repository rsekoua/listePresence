# ═══════════════════════════════════════════════════════════════════════════
#  Variables d'environnement de PRODUCTION
#  → copier en /var/www/liste/backend/.env  puis  chmod 600 .env
#  (ne JAMAIS committer le .env réel)
# ═══════════════════════════════════════════════════════════════════════════

# --- Secrets ---------------------------------------------------------------
# Générer chaque valeur séparément :
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# L'application REFUSE de démarrer si cette clé est absente, vaut la clé de
# développement, ou fait moins de 50 caractères.
DJANGO_SECRET_KEY=CHANGE_ME_secret_django_unique

# Secret de signature des JWT. OBLIGATOIRE en production et DISTINCT de la
# SECRET_KEY : si un jour la SECRET_KEY fuite (sauvegarde, capture d'écran de
# config), l'attaquant ne doit pas pouvoir en plus forger des jetons d'accès
# valides pour n'importe quel compte.
JWT_SECRET=CHANGE_ME_secret_jwt_different_du_precedent

JWT_ACCESS_LIFETIME_HOURS=8
JWT_REFRESH_LIFETIME_DAYS=7

# --- Mode ------------------------------------------------------------------
DJANGO_DEBUG=False

# Domaines autorisés (séparés par des virgules). `127.0.0.1` sert au
# health-check local de deploy.sh. Le joker `*` est refusé en production.
DJANGO_ALLOWED_HOSTS=liste.rsekoua.org,127.0.0.1

# Origines de confiance CSRF (schéma + domaine) — requis pour que la connexion
# à l'admin fonctionne en HTTPS derrière Nginx.
DJANGO_CSRF_TRUSTED_ORIGINS=https://liste.rsekoua.org

# URL publique encodée dans les QR Codes et les liens de réinitialisation.
PUBLIC_FORM_BASE_URL=https://liste.rsekoua.org

# --- Interface d'administration Django -------------------------------------
# Chemin de l'admin. Le déplacer hors de /admin/ écarte le bruit de fond des
# scanners automatiques ; ce n'est PAS une protection à soi seul — la vraie
# protection est l'allowlist d'IP côté Nginx (cf. deploy/nginx.conf).
# Doit correspondre EXACTEMENT au `location` du vhost Nginx.
# Laisser VIDE pour retirer complètement l'admin : c'est le réglage le plus sûr
# si vous administrez tout depuis l'interface React.
DJANGO_ADMIN_URL=gestion-interne

# --- Proxy -----------------------------------------------------------------
# True derrière Nginx (qui réécrit X-Forwarded-For) : les journaux d'audit et
# les compteurs anti-bruteforce voient alors la vraie IP cliente et non
# 127.0.0.1. ⚠️ Ne JAMAIS mettre True si l'application est exposée en direct :
# n'importe qui pourrait usurper son IP via un en-tête forgé et se rendre
# invisible pour la limitation de débit.
DJANGO_TRUST_PROXY=True

# --- Limitation de débit ---------------------------------------------------
# Connexion : échecs tolérés par IP, puis par compte visé (anti-bruteforce
# distribué), sur une fenêtre de 15 minutes.
LOGIN_RATELIMIT=10
LOGIN_RATELIMIT_USER=20
LOGIN_RATELIMIT_WINDOW=900

# Formulaire public : soumissions tolérées par IP et par fenêtre. À AUGMENTER
# pour un grand événement derrière un Wi-Fi ou une 4G partagée (tous les
# participants sortent alors par la même IP publique) : trop bas, des
# inscriptions légitimes seraient refusées lors d'un afflux.
PUBLIC_RATELIMIT=60
PUBLIC_RATELIMIT_WINDOW=300

# Pré-remplissage par n° de CNI : endpoint public qui RÉVÈLE des données
# personnelles (nom, téléphone, email) à qui devine un numéro. Limite basse
# assumée — un participant légitime ne l'appelle qu'une ou deux fois, un
# moissonneur l'appellerait en boucle. Ne pas relever sans raison.
PREFILL_RATELIMIT=8
PREFILL_RATELIMIT_WINDOW=300

# --- Journalisation --------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
# DEBUG pour tracer les requêtes SQL — diagnostic ponctuel UNIQUEMENT : les
# requêtes journalisées contiennent des données personnelles en clair.
DJANGO_LOG_SQL=WARNING

# --- Base de données : PostgreSQL -------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=presence
DB_USER=presence
DB_PASSWORD=CHANGE_ME_mot_de_passe_base
DB_HOST=127.0.0.1
DB_PORT=5432

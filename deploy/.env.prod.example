# Variables d'environnement de PRODUCTION — à copier en backend/.env sur le serveur
# (ne jamais committer le .env réel)

# Génère une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_secret_unique

# Production : DEBUG désactivé
DJANGO_DEBUG=False

# Domaines autorisés (séparés par des virgules). 127.0.0.1 est necessaire pour
# que le health-check local (deploy.sh, curl 127.0.0.1:8000/api/health) passe :
# sans lui Django repond 400 (Host non autorise) meme quand l'app va bien.
DJANGO_ALLOWED_HOSTS=liste.rsekoua.org,127.0.0.1

# Origines de confiance CSRF (schéma + domaine) — requis pour que la connexion
# à /admin fonctionne en HTTPS derrière Nginx.
DJANGO_CSRF_TRUSTED_ORIGINS=https://liste.rsekoua.org

# URL publique encodée dans les QR Codes (https en prod)
PUBLIC_FORM_BASE_URL=https://liste.rsekoua.org

# Secret JWT (distinct de la SECRET_KEY de préférence)
JWT_SECRET=CHANGE_ME_jwt_secret
JWT_ACCESS_LIFETIME_HOURS=8
JWT_REFRESH_LIFETIME_DAYS=7

# Confiance du proxy : True derrière Nginx (réécrit X-Forwarded-For), pour que
# les logs/rate-limiting voient la vraie IP cliente plutôt que 127.0.0.1.
DJANGO_TRUST_PROXY=True

# Journalisation
DJANGO_LOG_LEVEL=INFO
# Mettre DEBUG pour tracer les requêtes SQL (diagnostic ponctuel uniquement)
DJANGO_LOG_SQL=WARNING

# Base de données : MySQL (déjà installé sur le VPS). DB_ENGINE doit être
# explicite : sans lui, le code bascule par défaut sur PostgreSQL (non
# installé ici → l'appli ne démarrerait pas).
DB_ENGINE=django.db.backends.mysql
DB_NAME=presence
DB_USER=presence
DB_PASSWORD=CHANGE_ME_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

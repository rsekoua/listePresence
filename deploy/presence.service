# systemd — Gunicorn pour Gestion de Présence (VPS Ubuntu, Nginx en frontal)
#
# Installation :
#   sudo cp deploy/presence.socket deploy/presence.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now presence.socket presence.service
#
# Racine applicative : /var/www/liste.rsekoua.org, propriétaire `presence`
# (compte système sans shell ni mot de passe, dédié à cette application).

[Unit]
Description=Gunicorn — Gestion de Présence
Requires=presence.socket
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=notify
User=presence
Group=presence
WorkingDirectory=/var/www/liste.rsekoua.org/backend
EnvironmentFile=/var/www/liste.rsekoua.org/backend/.env
# Sorties non tamponnées : les journaux arrivent dans journald en temps réel
# plutôt qu'au remplissage du tampon — indispensable pour diagnostiquer un
# incident en cours.
Environment=PYTHONUNBUFFERED=1

ExecStart=/var/www/liste.rsekoua.org/backend/.venv/bin/gunicorn \
    config.wsgi:application \
    --bind unix:/run/presence.sock \
    --workers 3 \
    --threads 2 \
    --timeout 60 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --forwarded-allow-ips '*' \
    --access-logfile - \
    --error-logfile - \
    --capture-output
# --forwarded-allow-ips '*' est sûr ICI et seulement ici : sur une socket Unix
# la seule origine possible est Nginx (cf. permissions dans presence.socket),
# il n'existe pas de client distant capable de forger X-Forwarded-Proto.
# --max-requests recycle les workers : borne toute fuite mémoire lente (Pillow).

ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

# --- Durcissement du bac à sable (systemd-analyze security presence) -------
# L'application traite des fichiers envoyés par des inconnus (photos de CNI)
# via Pillow : en cas d'exécution de code par une faille du décodeur, ces
# restrictions limitent ce que le processus peut atteindre.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0027

# ProtectSystem=strict rend tout le disque en lecture seule : on ré-ouvre en
# écriture les deux seuls chemins où l'application écrit réellement.
# (La socket, elle, est créée par presence.socket AVANT le démarrage et héritée
#  par descripteur de fichier — Gunicorn n'a donc jamais à écrire dans /run.)
ReadWritePaths=/var/www/liste.rsekoua.org/backend/media
ReadWritePaths=/var/www/liste.rsekoua.org/backend/logs

# Bornes de ressources : un afflux d'uploads ne doit pas faire tomber le VPS.
LimitNOFILE=4096
TasksMax=256

[Install]
WantedBy=multi-user.target

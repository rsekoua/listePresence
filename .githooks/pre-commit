#!/usr/bin/env bash
# Garde-fou données personnelles : refuse de committer un notebook contenant des
# sorties d'exécution. Les cellules de sortie de `import_participants.ipynb`
# contiennent des noms, emails et numéros de CNI réels — une fois dans
# l'historique git, ils y restent.
#
# Activation (une fois par clone) :  git config core.hooksPath .githooks
set -euo pipefail

fautifs=()
while IFS= read -r f; do
    [ -n "$f" ] || continue
    if git show ":$f" | python3 -c '
import json, sys
nb = json.load(sys.stdin)
sys.exit(1 if any(c.get("outputs") for c in nb.get("cells", [])) else 0)
' 2>/dev/null; then
        continue
    fi
    fautifs+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.ipynb')

if [ ${#fautifs[@]} -gt 0 ]; then
    echo "❌ Notebook(s) avec des sorties d'exécution (données personnelles possibles) :" >&2
    printf '   - %s\n' "${fautifs[@]}" >&2
    echo >&2
    echo "   Nettoyer avant de committer :" >&2
    echo "     jupyter nbconvert --clear-output --inplace ${fautifs[*]}" >&2
    echo "   puis  git add ${fautifs[*]}" >&2
    exit 1
fi

# Configuration Django — copier vers .env et adapter les valeurs
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme-genere-une-cle-secrete
# Mode debug : True en développement uniquement. Si la variable est absente,
# l'application démarre en mode production durci (défaut sûr).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production (DJANGO_DEBUG=False) ---
# Origines de confiance CSRF (schéma + domaine, séparées par des virgules)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://presence.example.com
# Redirection HTTPS (activée par défaut hors DEBUG ; mettre False si TLS géré ailleurs)
# DJANGO_SECURE_SSL_REDIRECT=True
# Durée HSTS en secondes (défaut : 1 an)
# DJANGO_HSTS_SECONDS=31536000
# Secret JWT distinct de la SECRET_KEY (recommandé en production)
# JWT_SECRET=changeme-genere-un-autre-secret

# --- Limitation de débit (anti-bruteforce / anti-spam) ---
# Connexion : nombre d'échecs tolérés par IP avant blocage temporaire (défaut 10 / 15 min)
# LOGIN_RATELIMIT=10
# LOGIN_RATELIMIT_WINDOW=900
# Formulaire public : soumissions tolérées par IP (défaut 60 / 5 min). À AUGMENTER
# pour les grands événements derrière un Wi-Fi/4G partagé (même IP publique), sous
# peine de bloquer des participants légitimes lors d'un afflux.
# PUBLIC_RATELIMIT=60
# PUBLIC_RATELIMIT_WINDOW=300

# --- Base PostgreSQL (sinon SQLite par défaut) ---
# DB_NAME=presence
# DB_USER=presence
# DB_PASSWORD=changeme
# DB_HOST=127.0.0.1
# DB_PORT=5432
